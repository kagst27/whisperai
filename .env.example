# Folder to watch for incoming voice memos
INPUT_DIR=G:\\VoiceMemo

# Where to write transcript HTML files
OUTPUT_DIR=G:\\VoiceMemo\\transcripts

# Whisper model: tiny, base, small, medium, large
MODEL_NAME=base

# true to watch folder continuously; false to only process --file
WATCH_MODE=true

# Subfolder inside OUTPUT_DIR that contains iPhone transcripts
IPHONE_SUBDIR=transcript_iphone

# Where to write comparison reports
COMPARE_OUTPUT_DIR=G:\\VoiceMemo\\transcripts\\comparisons
